# Copy to your deployment secret/env system, not to source control as .env.production.

# Compose/orchestrator host-side paths. These are used by docker compose for
# bind mounts and secret sources; point them at protected deployment paths.
PROD_ENV_FILE=.env.production
TLS_CERT_DIR=/secure/certs/nginx
PROMETHEUS_CERT_DIR=/secure/certs/prometheus
SECRET_KEY_FILE_HOST=/secure/secrets/secret_key
DATABASE_URL_FILE_HOST=/secure/secrets/database_url
REDIS_URL_FILE_HOST=/secure/secrets/redis_url
GOOGLE_API_KEY_FILE_HOST=/secure/secrets/google_api_key
NPCI_API_KEY_FILE_HOST=/secure/secrets/npci_api_key
NPCI_CLIENT_CERT_FILE_HOST=/secure/secrets/npci_client.crt
NPCI_CLIENT_KEY_FILE_HOST=/secure/secrets/npci_client.key
A2A_HMAC_SECRET_FILE_HOST=/secure/secrets/a2a_hmac_secret
METRICS_BEARER_TOKEN_FILE_HOST=/secure/secrets/metrics_bearer_token
SMTP_PASS_FILE_HOST=/secure/secrets/smtp_pass

APP_ENV=production
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=mg_access_token
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://admin.example.com

# Prefer *_FILE values mounted by your secret manager. Direct values work but
# should only be injected by the orchestrator secret store.
SECRET_KEY_FILE=/run/secrets/secret_key
DATABASE_URL_FILE=/run/secrets/database_url
REDIS_URL_FILE=/run/secrets/redis_url
GOOGLE_API_KEY_FILE=/run/secrets/google_api_key
NPCI_API_KEY_FILE=/run/secrets/npci_api_key
A2A_HMAC_SECRET_FILE=/run/secrets/a2a_hmac_secret
METRICS_BEARER_TOKEN_FILE=/run/secrets/metrics_bearer_token

# Managed service endpoints are loaded from the secret files above.
DATABASE_URL=
REDIS_URL=
GOOGLE_API_KEY=
SECRET_KEY=
NPCI_API_KEY=
A2A_HMAC_SECRET=
METRICS_BEARER_TOKEN=

NPCI_AGENT_URL=https://npci-agent.example.com/a2a
NPCI_CLIENT_CERT_FILE=/run/secrets/npci_client_cert
NPCI_CLIENT_KEY_FILE=/run/secrets/npci_client_key
A2A_INGESTION_MODE=worker
A2A_WORKER_POLL_SECONDS=2
A2A_MTLS_REQUIRED=true
A2A_JWT_REQUIRED_EXTERNAL=true
A2A_CIDR_ALLOWLIST=203.0.113.0/24
# Use the exact proxy-native fingerprint or the SHA-256 fingerprint computed
# from X-SSL-Client-Cert; colons are optional.
A2A_MTLS_FINGERPRINTS=replace-with-client-cert-fingerprint
A2A_MTLS_PARTNER_MAP=replace-with-client-cert-fingerprint=npci_central
A2A_JWT_PARTNER_MAP=npci_central=npci_central
A2A_KNOWN_AGENTS=npci_central,npci_cert_lab
A2A_NONCE_TTL_SECONDS=600
A2A_NONCE_CLEANUP_INTERVAL_SECONDS=600
CHAT_MAX_REQUEST_BYTES=65536
SHUTDOWN_GRACE_SECONDS=30
API_WORKERS=4
API_WORKER_TIMEOUT_SECONDS=120

CHAT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_EMAIL_RATE_LIMIT_PER_MINUTE=5
A2A_EXTERNAL_RATE_LIMIT_PER_MINUTE=120
WS_TICKET_TTL_SECONDS=60

EXTERNAL_AI_DATA_PROCESSING_APPROVED=false
A2A_NOTIFY_LIST=ops@example.com,compliance@example.com
A2A_NOTIFY_ALLOWLIST=ops@example.com,compliance@example.com
A2A_NOTIFY_ALLOWED_DOMAINS=example.com
NPCI_REPLY_AUTO_INGEST=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS_FILE=/run/secrets/smtp_pass

A2A_CONFIDENCE_THRESHOLD=0.45
A2A_EMBEDDING_DIM=3072
A2A_EMBEDDING_SCALE=1.5
A2A_SOURCE_BIAS_NPCI_OFFICIAL=-0.06
A2A_SOURCE_BIAS_NPCI_AGENT=-0.03
A2A_SOURCE_BIAS_ADMIN_UPLOAD=0.00
A2A_SOURCE_BIAS_OLD_POLICY=0.04
A2A_SOURCE_BIAS_DEFAULT=0.02
A2A_MAX_INGEST_BYTES=52428800
A2A_MAX_REQUEST_BYTES=77594624
