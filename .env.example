# Mindgate Policy Bot environment variables

GOOGLE_API_KEY=<google-api-key>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindgate_db
APP_ENV=development
REDIS_URL=

# REQUIRED — app will crash on startup if missing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<long-random-secret-key>
# Optional secret-manager file mounts. Direct env vars take precedence.
SECRET_KEY_FILE=
DATABASE_URL_FILE=
REDIS_URL_FILE=
GOOGLE_API_KEY_FILE=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Note: Default is 60 minutes (production-safe). Increase to 480 max without
# implementing a refresh-token flow. For 24h sessions use 1440.
AUTH_COOKIE_NAME=mg_access_token
AUTH_COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins (no wildcard with credentials).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

NPCI_AGENT_URL=https://npci-agent.example.com/a2a
NPCI_API_KEY=<secret>

# ── Google A2A (ADK) transport ────────────────────────────────────────────
# Selects the Bank→NPCI wire transport for all outbound messages:
#   legacy → custom NPCI JSON-RPC + HMAC (default)
#   a2a    → Google A2A via ADK (interoperates with NPCI's Google-A2A agent)
NPCI_TRANSPORT=legacy
# Port the bank's ADK A2A server binds (a2a_adk_server:a2a_app). Its own card is
# served at http://<host>:BANK_A2A_PORT/.well-known/agent-card.json
BANK_A2A_PORT=8002
# NPCI (or mock) agent's A2A card URL — required when NPCI_TRANSPORT=a2a.
# For the bundled mock ADK agent: http://localhost:8001/.well-known/agent-card.json
NPCI_A2A_AGENT_CARD_URL=http://localhost:8001/.well-known/agent-card.json
NPCI_CLIENT_CERT_FILE=
NPCI_CLIENT_KEY_FILE=
A2A_HMAC_SECRET=<shared-secret-with-npci>
A2A_INGESTION_MODE=inline
A2A_WORKER_POLL_SECONDS=2
NPCI_API_KEY_FILE=
A2A_HMAC_SECRET_FILE=
A2A_MTLS_REQUIRED=true
A2A_JWT_REQUIRED_EXTERNAL=true
A2A_CIDR_ALLOWLIST=
# Fingerprints may be proxy-native or SHA-256 computed from X-SSL-Client-Cert.
A2A_MTLS_FINGERPRINTS=
A2A_MTLS_PARTNER_MAP=
A2A_JWT_PARTNER_MAP=npci_central=npci_central
A2A_KNOWN_AGENTS=npci_central,npci_cert_lab
A2A_NONCE_TTL_SECONDS=600
A2A_NONCE_CLEANUP_INTERVAL_SECONDS=600
CHAT_MAX_REQUEST_BYTES=65536
METRICS_BEARER_TOKEN=<metrics-scrape-token>
METRICS_BEARER_TOKEN_FILE=
# Set to path of a writable tmpfs dir when running Gunicorn with multiple workers.
# This enables prometheus_client multiprocess mode so all workers share counters.
# Example: PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc (set via docker-compose.prod.yml)
PROMETHEUS_MULTIPROC_DIR=
SHUTDOWN_GRACE_SECONDS=30
CHAT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_EMAIL_RATE_LIMIT_PER_MINUTE=5
A2A_EXTERNAL_RATE_LIMIT_PER_MINUTE=120
WS_TICKET_TTL_SECONDS=60
# Postgres-backed account lockout: N failures in the window lock the account.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
# Per-process DB pool (see docs/PRODUCTION_RUNBOOK.md "Connection Capacity").
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Daily retention purge (runs in worker.py) fires after this UTC hour.
RETENTION_HOUR_UTC=2

# Compliance gate. Keep false until NPCI data residency/vendor terms allow external AI processing.
EXTERNAL_AI_DATA_PROCESSING_APPROVED=false
A2A_NOTIFY_LIST=ops@mindgate.in,compliance@mindgate.in
A2A_NOTIFY_ALLOWLIST=ops@mindgate.in,compliance@mindgate.in
A2A_NOTIFY_ALLOWED_DOMAINS=mindgate.in
NPCI_REPLY_AUTO_INGEST=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=<app-password>
A2A_CONFIDENCE_THRESHOLD=0.45
# Set true to write structured 'confidence_sample' log lines for calibration.
# Does NOT log raw query text. Safe to enable in production for data collection.
A2A_LOG_CONFIDENCE_SAMPLES=false
A2A_EMBEDDING_DIM=3072
A2A_EMBEDDING_SCALE=1.5
A2A_SOURCE_BIAS_NPCI_OFFICIAL=-0.06
A2A_SOURCE_BIAS_NPCI_AGENT=-0.03
A2A_SOURCE_BIAS_ADMIN_UPLOAD=0.00
A2A_SOURCE_BIAS_OLD_POLICY=0.04
A2A_SOURCE_BIAS_DEFAULT=0.02

# Maximum A2A ingest file size in bytes (default: 50 MB).
A2A_MAX_INGEST_BYTES=52428800
A2A_MAX_REQUEST_BYTES=77594624

# CSRF protection — validates Origin/Referer on cookie-auth POST/DELETE routes.
# Set false only for local dev/test. Always true in production.
CSRF_ENFORCE=true

# PostgreSQL query timeout in milliseconds (default 30 s).
# Prevents runaway queries from exhausting the connection pool.
DB_STATEMENT_TIMEOUT_MS=30000
